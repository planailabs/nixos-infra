 // Re-export FileStorage as Storage for backwards compatibility
 pub type Storage = FileStorage;
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn storage() -> FileStorage {
+        FileStorage {
+            base_path: PathBuf::from("/var/lib/xzar-server/storage"),
+        }
+    }
+
+    #[test]
+    fn file_path_resolves_plain_store_name() {
+        let name = "0m5k1yq3m2c9f1xpnbrak5df9jyy3rn6b-mac-mgmt-devel.drv";
+        let path = storage().file_path(name).unwrap();
+
+        assert_eq!(
+            path,
+            PathBuf::from("/var/lib/xzar-server/storage").join(name)
+        );
+    }
+
+    #[test]
+    fn file_path_refuses_traversal() {
+        for name in [
+            "../escape",
+            "../../etc/passwd",
+            "a/../../b",
+            "/etc/passwd",
+            "sub/nar.xz",
+            "..",
+            ".",
+            "",
+            "..\\escape",
+        ] {
+            assert!(
+                storage().file_path(name).is_err(),
+                "accepted unsafe storage filename {:?}",
+                name
+            );
+        }
+    }
+}
