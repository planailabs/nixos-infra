     /// Get the full path for a file
-    fn file_path(&self, filename: &str) -> PathBuf {
-        self.base_path.join(filename)
+    ///
+    /// Names arrive verbatim from upload requests, and `Path::join` keeps `..`,
+    /// so only a single plain file name is accepted: a request must not be able
+    /// to name a path outside `base_path` (this also covers the delete path used
+    /// for cleanup and GC).
+    fn file_path(&self, filename: &str) -> Result<PathBuf> {
+        let mut components = Path::new(filename).components();
+        let is_plain_name =
+            matches!(components.next(), Some(std::path::Component::Normal(_)))
+                && components.next().is_none();
+
+        if !is_plain_name || filename.contains('\\') {
+            return Err(AppError::BadRequest(format!(
+                "Invalid storage filename: {}",
+                filename
+            )));
+        }
+
+        Ok(self.base_path.join(filename))
     }
 }
 
