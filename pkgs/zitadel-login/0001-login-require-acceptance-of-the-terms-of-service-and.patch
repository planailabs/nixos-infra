@@ -0,0 +1,60 @@
+import { DynamicTheme } from "@/components/dynamic-theme";
+import { LegalAcceptanceForm } from "@/components/legal-acceptance-form";
+import { Translated } from "@/components/translated";
+import { UserAvatar } from "@/components/user-avatar";
+import { getServiceConfig } from "@/lib/service-url";
+import { loadSessionById } from "@/lib/session";
+import { getBrandingSettings, getLegalAndSupportSettings } from "@/lib/zitadel";
+import { headers } from "next/headers";
+import { redirect } from "next/navigation";
+
+// Asked before an OIDC/SAML flow completes when the terms of service or privacy policy changed since the
+// user last accepted them (lib/legal-acceptance.ts)
+export default async function Page(props: { searchParams: Promise<Record<string | number | symbol, string | undefined>> }) {
+  const searchParams = await props.searchParams;
+  const { sessionId, requestId, organization } = searchParams;
+
+  if (!requestId) {
+    return redirect("/loginname");
+  }
+
+  const _headers = await headers();
+  const { serviceConfig } = getServiceConfig(_headers);
+
+  const session = sessionId ? await loadSessionById(serviceConfig, sessionId, organization) : undefined;
+  if (!session?.factors?.user) {
+    const params = new URLSearchParams({ requestId });
+    if (organization) {
+      params.set("organization", organization);
+    }
+    return redirect("/loginname?" + params);
+  }
+
+  const userOrg = session.factors.user.organizationId;
+  const branding = await getBrandingSettings({ serviceConfig, organization: userOrg });
+  const legal = await getLegalAndSupportSettings({ serviceConfig, organization: userOrg });
+
+  return (
+    <DynamicTheme branding={branding}>
+      <div className="flex flex-col space-y-4">
+        <h1>
+          <Translated i18nKey="title" namespace="legal" />
+        </h1>
+        <p className="ztdl-p">
+          <Translated i18nKey="description" namespace="legal" />
+        </p>
+        <UserAvatar
+          loginName={session.factors.user.loginName}
+          displayName={session.factors.user.displayName}
+          showDropdown={false}
+        />
+      </div>
+
+      <div className="w-full">
+        {legal && (
+          <LegalAcceptanceForm legal={legal} sessionId={session.id} requestId={requestId} organization={organization} />
+        )}
+      </div>
+    </DynamicTheme>
+  );
+}
