@@ -0,0 +1,31 @@
+"use server";
+
+import { completeFlowOrGetUrl } from "@/lib/client";
+import { recordLegalAcceptance } from "@/lib/legal-acceptance";
+import { getServiceConfig } from "@/lib/service-url";
+import { loadSessionById } from "@/lib/session";
+import { getTranslations } from "next-intl/server";
+import { headers } from "next/headers";
+
+export async function acceptLegal(command: { sessionId: string; requestId: string; organization?: string }) {
+  const t = await getTranslations("legal");
+  const _headers = await headers();
+  const { serviceConfig } = getServiceConfig(_headers);
+
+  // the session cookie proves the user is the session's: only they can accept for themselves
+  const session = await loadSessionById(serviceConfig, command.sessionId, command.organization);
+  const user = session?.factors?.user;
+  if (!session || !user?.id) {
+    return { error: t("errors.sessionNotFound") };
+  }
+
+  if (!(await recordLegalAcceptance({ serviceConfig, userId: user.id, organization: user.organizationId }))) {
+    return { error: t("errors.documentsUnavailable") };
+  }
+
+  return completeFlowOrGetUrl({
+    sessionId: session.id,
+    requestId: command.requestId,
+    organization: command.organization,
+  });
+}
