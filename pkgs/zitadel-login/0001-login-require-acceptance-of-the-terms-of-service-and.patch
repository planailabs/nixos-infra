+export async function getUserMetadataValue({
+  serviceConfig,
+  userId,
+  key,
+}: WithServiceConfig<{ userId: string; key: string }>): Promise<string | undefined> {
+  const userService: Client<typeof UserService> = await createServiceForHost(UserService, serviceConfig);
+
+  const { metadata } = await userService.listUserMetadata({
+    userId,
+    filters: [{ filter: { case: "keyFilter", value: { key, method: TextFilterMethod.EQUALS } } }],
+  });
+
+  const value = metadata.find((m) => m.key === key)?.value;
+  return value ? new TextDecoder().decode(value) : undefined;
+}
