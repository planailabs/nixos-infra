+"use client";
+
+import { handleServerActionResponse } from "@/lib/client-utils";
+import { acceptLegal } from "@/lib/server/legal";
+import { LegalAndSupportSettings } from "@zitadel/proto/zitadel/settings/v2/legal_settings_pb";
+import { useRouter } from "next/navigation";
+import { useState } from "react";
+import { Alert } from "./alert";
+import { AutoSubmitForm } from "./auto-submit-form";
+import { Button, ButtonVariants } from "./button";
+import { PrivacyPolicyCheckboxes } from "./privacy-policy-checkboxes";
+import { Spinner } from "./spinner";
+import { Translated } from "./translated";
+
+export function LegalAcceptanceForm({
+  legal,
+  sessionId,
+  requestId,
+  organization,
+}: {
+  legal: LegalAndSupportSettings;
+  sessionId: string;
+  requestId: string;
+  organization?: string;
+}) {
+  const [accepted, setAccepted] = useState(false);
+  const [loading, setLoading] = useState(false);
+  const [error, setError] = useState("");
+  const [samlData, setSamlData] = useState<{ url: string; fields: Record<string, string> } | null>(null);
+  const router = useRouter();
+
+  async function submit() {
+    setError("");
+    setLoading(true);
+    try {
+      handleServerActionResponse(await acceptLegal({ sessionId, requestId, organization }), router, setSamlData, setError);
+    } catch {
+      setError("Could not complete the request");
+    } finally {
+      setLoading(false);
+    }
+  }
+
+  return (
+    <div className="w-full">
+      {samlData && <AutoSubmitForm url={samlData.url} fields={samlData.fields} />}
+      <PrivacyPolicyCheckboxes legal={legal} onChange={setAccepted} i18nKey="agreeTo" namespace="legal" />
+
+      {error && (
+        <div className="py-4">
+          <Alert>{error}</Alert>
+        </div>
+      )}
+
+      <div className="mt-8 flex w-full flex-row items-center">
+        <span className="flex-grow"></span>
+        <Button
+          type="button"
+          onClick={submit}
+          disabled={!accepted || loading}
+          variant={ButtonVariants.Primary}
+          data-testid="submit-button"
+        >
+          {loading && <Spinner className="mr-2 h-5 w-5" />}
+          <Translated i18nKey="submit" namespace="legal" />
+        </Button>
+      </div>
+    </div>
+  );
+}
