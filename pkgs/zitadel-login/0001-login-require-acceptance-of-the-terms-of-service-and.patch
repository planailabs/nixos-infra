diff --git a/apps/login/src/lib/legal-acceptance.test.ts b/apps/login/src/lib/legal-acceptance.test.ts
new file mode 100644
index 0000000..19fbdb2
--- /dev/null
+++ b/apps/login/src/lib/legal-acceptance.test.ts
@@ -0,0 +1,123 @@
+import { createHash } from "node:crypto";
+import { afterEach, beforeEach, describe, expect, it, vi } from "vitest";
+import { currentLegalHash, legalAcceptancePath, recordLegalAcceptance } from "./legal-acceptance";
+import { getLegalAndSupportSettings, getUserMetadataValue, setUserMetadataValue } from "./zitadel";
+
+vi.mock("./zitadel", () => ({
+  getLegalAndSupportSettings: vi.fn(),
+  getUserMetadataValue: vi.fn(),
+  setUserMetadataValue: vi.fn(),
+}));
+
+const serviceConfig = { baseUrl: "https://zitadel.example" } as any;
+const sha256 = (s: string) => createHash("sha256").update(s).digest("hex");
+const session = { id: "s1", factors: { user: { id: "u1", organizationId: "o1" } } } as any;
+
+let docs: Record<string, string | null>;
+const fetchMock = vi.fn(async (url: string) => {
+  const body = docs[url];
+  return body === null || body === undefined ? new Response("", { status: 503 }) : new Response(body);
+});
+
+function links(tosLink?: string, privacyPolicyLink?: string) {
+  vi.mocked(getLegalAndSupportSettings).mockResolvedValue({ tosLink, privacyPolicyLink } as any);
+}
+
+beforeEach(() => {
+  docs = {};
+  fetchMock.mockClear();
+  vi.stubGlobal("fetch", fetchMock);
+  vi.mocked(getUserMetadataValue).mockReset();
+  vi.mocked(setUserMetadataValue).mockReset();
+});
+
+afterEach(() => {
+  vi.useRealTimers();
+  vi.unstubAllGlobals();
+});
+
+describe("currentLegalHash", () => {
+  it("is the document's sha256 when both links point to it", async () => {
+    docs["https://a.example/legal-de.md"] = "# AGB";
+    links("https://a.example/legal-de.md", "https://a.example/legal-de.md");
+    expect(await currentLegalHash(serviceConfig, "o1")).toBe(sha256("# AGB"));
+    expect(fetchMock).toHaveBeenCalledTimes(1);
+  });
+
+  it("covers both documents when they differ", async () => {
+    docs["https://b.example/tos"] = "tos";
+    docs["https://b.example/privacy"] = "privacy";
+    links("https://b.example/tos", "https://b.example/privacy");
+    expect(await currentLegalHash(serviceConfig)).toBe(sha256(sha256("tos") + "\n" + sha256("privacy")));
+  });
+
+  it("is null without links and undefined when a document can't be fetched", async () => {
+    links();
+    expect(await currentLegalHash(serviceConfig)).toBeNull();
+    links("https://c.example/down");
+    expect(await currentLegalHash(serviceConfig)).toBeUndefined();
+  });
+
+  it("refetches after the TTL and keeps the last hash while the document is down", async () => {
+    vi.useFakeTimers();
+    const url = "https://d.example/legal";
+    links(url);
+    docs[url] = "v1";
+    expect(await currentLegalHash(serviceConfig)).toBe(sha256("v1"));
+
+    docs[url] = "v2";
+    expect(await currentLegalHash(serviceConfig)).toBe(sha256("v1")); // cached
+    vi.advanceTimersByTime(301_000);
+    expect(await currentLegalHash(serviceConfig)).toBe(sha256("v2"));
+
+    docs[url] = null;
+    vi.advanceTimersByTime(301_000);
+    expect(await currentLegalHash(serviceConfig)).toBe(sha256("v2"));
+  });
+});
+
+describe("legalAcceptancePath", () => {
+  const url = "https://e.example/legal";
+  beforeEach(() => {
+    docs[url] = "current";
+    links(url);
+  });
+
+  it("sends a user who never accepted, or accepted another version, to the legal page", async () => {
+    for (const accepted of [undefined, sha256("old")]) {
+      vi.mocked(getUserMetadataValue).mockResolvedValue(accepted);
+      expect(await legalAcceptancePath({ serviceConfig, session, requestId: "oidc_r1" })).toBe(
+        "/legal?sessionId=s1&requestId=oidc_r1&organization=o1",
+      );
+    }
+    expect(getUserMetadataValue).toHaveBeenCalledWith({ serviceConfig, userId: "u1", key: "agb" });
+  });
+
+  it("lets a user who accepted the current version through", async () => {
+    vi.mocked(getUserMetadataValue).mockResolvedValue(sha256("current"));
+    expect(await legalAcceptancePath({ serviceConfig, session, requestId: "oidc_r1" })).toBeUndefined();
+  });
+
+  it("doesn't ask when there are no documents or they can't be fetched", async () => {
+    links();
+    expect(await legalAcceptancePath({ serviceConfig, session, requestId: "oidc_r1" })).toBeUndefined();
+    links("https://e.example/down");
+    expect(await legalAcceptancePath({ serviceConfig, session, requestId: "oidc_r1" })).toBeUndefined();
+    expect(getUserMetadataValue).not.toHaveBeenCalled();
+  });
+});
+
+describe("recordLegalAcceptance", () => {
+  it("stores the current hash", async () => {
+    docs["https://f.example/legal"] = "current";
+    links("https://f.example/legal");
+    expect(await recordLegalAcceptance({ serviceConfig, userId: "u1", organization: "o1" })).toBe(true);
+    expect(setUserMetadataValue).toHaveBeenCalledWith({ serviceConfig, userId: "u1", key: "agb", value: sha256("current") });
+  });
+
+  it("fails when the documents can't be fetched", async () => {
+    links("https://f.example/down");
+    expect(await recordLegalAcceptance({ serviceConfig, userId: "u1" })).toBe(false);
+    expect(setUserMetadataValue).not.toHaveBeenCalled();
+  });
+});
diff --git a/apps/login/src/lib/legal-acceptance.ts b/apps/login/src/lib/legal-acceptance.ts
new file mode 100644
index 0000000..d6ba94f
--- /dev/null
+++ b/apps/login/src/lib/legal-acceptance.ts
@@ -0,0 +1,126 @@
+import { Session } from "@zitadel/proto/zitadel/session/v2/session_pb";
+import { createHash } from "node:crypto";
+import { resolveLocalizedLegalLink } from "./legal-links";
+import { createLogger } from "./logger";
+import { getLegalAndSupportSettings, getUserMetadataValue, ServiceConfig, setUserMetadataValue } from "./zitadel";
+
+const logger = createLogger("legal-acceptance");
+
+// User metadata key holding the hash of the terms of service and privacy policy the user last accepted
+export const LEGAL_METADATA_KEY = process.env.LEGAL_ACCEPTANCE_METADATA_KEY || "agb";
+const documentTTL = Number(process.env.LEGAL_DOCUMENT_TTL_SECONDS ?? 300) * 1000;
+
+const documents = new Map<string, { hash: string; fetchedAt: number }>();
+
+function sha256(data: string | Uint8Array): string {
+  return createHash("sha256").update(data).digest("hex");
+}
+
+/** sha256 of the document at url, fetched at most every LEGAL_DOCUMENT_TTL_SECONDS; the last hash if a fetch fails. */
+async function documentHash(url: string): Promise<string | undefined> {
+  const cached = documents.get(url);
+  if (cached && Date.now() - cached.fetchedAt < documentTTL) {
+    return cached.hash;
+  }
+
+  try {
+    const response = await fetch(url, { cache: "no-store", signal: AbortSignal.timeout(5000) });
+    if (!response.ok) {
+      throw new Error(`HTTP ${response.status}`);
+    }
+    const hash = sha256(new Uint8Array(await response.arrayBuffer()));
+    documents.set(url, { hash, fetchedAt: Date.now() });
+    return hash;
+  } catch (error) {
+    logger.error("Could not fetch legal document", { url, error: String(error), usingLastHash: !!cached });
+    return cached?.hash;
+  }
+}
+
+/**
+ * The hash users have to have accepted: of the one document when the terms of service and the privacy
+ * policy link to the same one, else of both. null: the organization links to none, there is nothing to
+ * accept. undefined: a document could not be fetched yet.
+ */
+export async function currentLegalHash(
+  serviceConfig: ServiceConfig,
+  organization?: string,
+): Promise<string | null | undefined> {
+  const legal = await getLegalAndSupportSettings({ serviceConfig, organization });
+  // ponytail: a link with {{.Lang}} is hashed in English, so switching languages doesn't ask again
+  const links = [legal?.tosLink, legal?.privacyPolicyLink]
+    .filter((l): l is string => !!l)
+    .map((l) => resolveLocalizedLegalLink(l, "en")!)
+    .filter((l, i, all) => all.indexOf(l) === i);
+
+  if (links.length === 0) {
+    return null;
+  }
+
+  const hashes = await Promise.all(links.map(documentHash));
+  if (hashes.some((h) => !h)) {
+    return undefined;
+  }
+
+  return hashes.length === 1 ? hashes[0] : sha256(hashes.join("\n"));
+}
+
+/**
+ * Where the user has to go before the flow can complete: the legal page when the documents changed
+ * since the user last accepted them (or the user never did), else undefined.
+ */
+export async function legalAcceptancePath({
+  serviceConfig,
+  session,
+  requestId,
+}: {
+  serviceConfig: ServiceConfig;
+  session: Session;
+  requestId: string;
+}): Promise<string | undefined> {
+  const user = session.factors?.user;
+  if (!user?.id) {
+    return undefined;
+  }
+
+  const hash = await currentLegalHash(serviceConfig, user.organizationId);
+  if (hash === undefined) {
+    // availability beats a gate nobody can pass: the user is asked once the documents can be fetched again
+    logger.error("Legal documents unavailable, not asking for acceptance", { userId: user.id });
+    return undefined;
+  }
+  if (hash === null) {
+    return undefined;
+  }
+
+  const accepted = await getUserMetadataValue({ serviceConfig, userId: user.id, key: LEGAL_METADATA_KEY });
+  if (accepted === hash) {
+    return undefined;
+  }
+
+  const params = new URLSearchParams({ sessionId: session.id, requestId });
+  if (user.organizationId) {
+    params.set("organization", user.organizationId);
+  }
+  return "/legal?" + params;
+}
+
+/** Stores the current hash as the one the user accepted. false: the documents can't be fetched. */
+export async function recordLegalAcceptance({
+  serviceConfig,
+  userId,
+  organization,
+}: {
+  serviceConfig: ServiceConfig;
+  userId: string;
+  organization?: string;
+}): Promise<boolean> {
+  const hash = await currentLegalHash(serviceConfig, organization);
+  if (hash === undefined) {
+    return false;
+  }
+  if (hash !== null) {
+    await setUserMetadataValue({ serviceConfig, userId, key: LEGAL_METADATA_KEY, value: hash });
+  }
+  return true;
+}
